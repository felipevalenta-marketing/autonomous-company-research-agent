              "value": "={{\n  Number(\n    $json.statusCode\n    ?? $json.status\n    ?? (\n      $json.resolved_company?.company_name\n      && Array.isArray($json.evidence_bundle?.evidence)\n        ? 200\n        : 0\n    )\n  )\n}}",
